#!/bin/sh

set -eu

github_workspace=${GITHUB_WORKSPACE:-"$HOME/Documents/workspace/github.com"}
repo_parent="$github_workspace/rocpatel"
repo_dir="$repo_parent/macos-config"
repo_url="https://github.com/rocpatel/macos-config"

if ! xcode-select -p >/dev/null 2>&1; then
  xcode-select --install
  printf '%s\n' "Command Line Tools installation started. Re-run this script when it finishes."
  exit 0
fi

if [ -d "$repo_dir/.git" ]; then
  printf 'Using existing checkout: %s\n' "$repo_dir"
elif [ -e "$repo_dir" ]; then
  printf 'Cannot clone: %s exists but is not a Git repository.\n' "$repo_dir" >&2
  exit 1
else
  mkdir -p "$repo_parent"
  git clone --branch main --single-branch "$repo_url" "$repo_dir"
fi

exec make -C "$repo_dir" bootstrap
